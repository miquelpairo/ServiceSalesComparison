<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sales Comparison: {{ nombre_p1 }} vs {{ nombre_p2 }} - {{ timestamp_short }}</title>
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.5.1.js"></script>
    
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    
    <script src="https://cdn.plot.ly/plotly-latest.min.js"></script>
    
    {% include 'partials/_styles.html' %}
</head>
<body>

	<!-- Boton hamburguesa (solo visible en movil) -->
	<button class="sidebar-toggle" onclick="toggleSidebar()" aria-label="Toggle filters">☰</button>
	<!-- Overlay -->
	<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>
    <!-- SIDEBAR -->
    <div class="sidebar">
        <h2>📋 Índice</h2>
        <ul>
            <li><a href="#config-section">Analysis Configuration</a></li>
            <li><a href="#overview-section">Overview</a></li>
            <li><a href="#charts-section">Comparative Charts</a></li>
            <li><a href="#tables-section">Data Tables</a></li>
        </ul>
        
        <!-- Scope Badge -->
        <div class="active-filters-section" style="margin-top:10px;">
            <h3>🧭 Scope</h3>
            <div id="scopeBadge" class="active-chip">All service items</div>
        </div>
        
        <div style="padding: 20px;">
            <div class="filter-group">
                <details>
                    <summary>
                        <span class="summary-text">🏷️ Product Types</span>
                        <span class="filter-actions">
                            <button type="button" class="mini-btn" onclick="setGroupChecked('type', true); event.preventDefault(); event.stopPropagation();">All</button>
                            <button type="button" class="mini-btn" onclick="setGroupChecked('type', false); event.preventDefault(); event.stopPropagation();">None</button>
                        </span>
                    </summary>
                    <div class="checkbox-group" id="typeFilters"></div>
                </details>
            </div>
            <div class="filter-group">
				<details>
					<summary>
						<span class="summary-text">📅 Month</span>
						<span class="filter-actions">
							<button type="button" class="mini-btn" onclick="setGroupChecked('month', true); event.preventDefault(); event.stopPropagation();">All</button>
							<button type="button" class="mini-btn" onclick="setGroupChecked('month', false); event.preventDefault(); event.stopPropagation();">None</button>
						</span>
					</summary>
					<div class="checkbox-group" id="monthFilters"></div>
				</details>
			</div>
            <div class="filter-group">
                <details>
                    <summary>
                        <span class="summary-text">📦 Sets</span>
                        <span class="filter-actions">
                            <button type="button" class="mini-btn" onclick="setGroupChecked('set', true); event.preventDefault(); event.stopPropagation();">All</button>
                            <button type="button" class="mini-btn" onclick="setGroupChecked('set', false); event.preventDefault(); event.stopPropagation();">None</button>
                        </span>
                    </summary>
                    <div class="checkbox-group" id="setFilters"></div>
                </details>
            </div>
            
            <div class="filter-group">
                <details>
                    <summary>
                        <span class="summary-text">👤 Sales Representatives</span>
                        <span class="filter-actions">
                            <button type="button" class="mini-btn" onclick="setGroupChecked('rep', true); event.preventDefault(); event.stopPropagation();">All</button>
                            <button type="button" class="mini-btn" onclick="setGroupChecked('rep', false); event.preventDefault(); event.stopPropagation();">None</button>
                        </span>
                    </summary>
                    <div class="checkbox-group" id="repFilters"></div>
                </details>
            </div>
            
            {% if available_market_orgs and available_market_orgs|length > 0 %}
            <div class="filter-group">
                <details>
                    <summary>
                        <span class="summary-text">🏢 Market Organization</span>
                        <span class="filter-actions">
                            <button type="button" class="mini-btn" onclick="setGroupChecked('mo', true); event.preventDefault(); event.stopPropagation();">All</button>
                            <button type="button" class="mini-btn" onclick="setGroupChecked('mo', false); event.preventDefault(); event.stopPropagation();">None</button>
                        </span>
                    </summary>
                    <div class="checkbox-group" id="moFilters"></div>
                </details>
            </div>
            {% endif %}
            
            {% if available_territories and available_territories|length > 0 %}
            <div class="filter-group">
                <details>
                    <summary>
                        <span class="summary-text">🌍 Sales Territory</span>
                        <span class="filter-actions">
                            <button type="button" class="mini-btn" onclick="setGroupChecked('territory', true); event.preventDefault(); event.stopPropagation();">All</button>
                            <button type="button" class="mini-btn" onclick="setGroupChecked('territory', false); event.preventDefault(); event.stopPropagation();">None</button>
                        </span>
                    </summary>
                    <div class="checkbox-group" id="territoryFilters"></div>
                </details>
            </div>
            {% endif %}
            
            {% if available_countries and available_countries|length > 0 %}
            <div class="filter-group">
                <details>
                    <summary>
                        <span class="summary-text">🌎 Country</span>
                        <span class="filter-actions">
                            <button type="button" class="mini-btn" onclick="setGroupChecked('country', true); event.preventDefault(); event.stopPropagation();">All</button>
                            <button type="button" class="mini-btn" onclick="setGroupChecked('country', false); event.preventDefault(); event.stopPropagation();">None</button>
                        </span>
                    </summary>
                    <div class="checkbox-group" id="countryFilters"></div>
                </details>
            </div>
            {% endif %}
            
            {% if available_segments and available_segments|length > 0 %}
            <div class="filter-group">
                <details>
                    <summary>
                        <span class="summary-text">👥 End User Segment</span>
                        <span class="filter-actions">
                            <button type="button" class="mini-btn" onclick="setGroupChecked('segment', true); event.preventDefault(); event.stopPropagation();">All</button>
                            <button type="button" class="mini-btn" onclick="setGroupChecked('segment', false); event.preventDefault(); event.stopPropagation();">None</button>
                        </span>
                    </summary>
                    <div class="checkbox-group" id="segmentFilters"></div>
                </details>
            </div>
            {% endif %}
            
            <div class="filter-group">
                <details open>
                    <summary>
                        <span class="summary-text">🔍 Search Service</span>
                    </summary>
                    <div class="quick-filters">
                        {% for keyword in quick_filter_keywords %}
                        <span class="quick-filter-tag" data-keyword="{{ keyword }}" onclick="toggleQuickFilter(this)">{{ keyword }}</span>
                        {% endfor %}
                    </div>
                    <input type="text" id="searchInput" placeholder="Or type custom search..." style="margin-top: 8px;">
                    
                    <div class="quick-mode-toggle">
                        <label>
                            <input type="radio" name="quickMode" value="AND" checked onchange="setQuickMode('AND')">
                            AND
                        </label>
                        <label>
                            <input type="radio" name="quickMode" value="OR" onchange="setQuickMode('OR')">
                            OR
                        </label>
                    </div>
                </details>
            </div>
            
            <div class="filter-group">
                <details>
                    <summary>
                        <span class="summary-text">👥 Customer</span>
                    </summary>
                    <input type="text" id="customerInput" placeholder="e.g., 'Universidad', 'Hospital'..." style="margin-top: 8px;">
                </details>
            </div>
            
            <button class="apply-filters-btn" onclick="applyFilters()">🔄 Apply Filters</button>
            <button class="reset-filters-btn" onclick="resetFilters()">♻ Reset Filters</button>
            
            <div class="active-filters-section">
                <h3>📌 Active Filters</h3>
                <div id="resultCount"></div>
                <div id="activeChips"></div>
            </div>
        </div>
    </div>
    
    <!-- MAIN CONTENT -->
    <div class="main-content">
        <h1>📊 Sales Comparison: {{ nombre_p1 }} vs {{ nombre_p2 }}</h1>
        
        <!-- CONFIG INFO - EXPANDABLE -->
        <details class="expandable-section" id="config-section">
            <summary>⚙️ Analysis Configuration</summary>
            <div class="expandable-content">
                <table>
                    {% for param, value in config_info.items() %}
                    <tr>
                        <th>{{ param }}</th>
                        <td>{{ value }}</td>
                    </tr>
                    {% endfor %}
                </table>
            </div>
        </details>
        
        <!-- OVERVIEW SECTION -->
        <div class="info-box" id="overview-section">
            <h2>Financial Summary</h2>
            
            <div class="metrics">
                <div class="metric-card white">
                    <div class="label">Total {{ nombre_p1 }}</div>
                    <div class="value" id="metricP1">€{{ "{:,.2f}".format(metrics.total_p1) }}</div>
                </div>
                <div class="metric-card white">
                    <div class="label">Total {{ nombre_p2 }}</div>
                    <div class="value" id="metricP2">€{{ "{:,.2f}".format(metrics.total_p2) }}</div>
                </div>
                <div class="metric-card white">
                    <div class="label">Total Difference</div>
                    <div class="value" id="metricDiff">€{{ "{:,.2f}".format(metrics.diferencia_total) }}</div>
                    <div class="delta">{{ "%+.1f"|format(metrics.porcentaje_cambio) }}%</div>
                </div>
                <div class="metric-card white">
                    <div class="label">Total Records</div>
                    <div class="value" id="metricTotal">{{ "{:,}".format(metrics.total_records) }}</div>
                </div>
            </div>

			<!-- PRODUCT SUMMARY -->
			<details id="product-summary-section" style="margin: 20px 0;">
				<summary style="cursor:pointer; font-size:1.2rem; font-weight:600; padding: 8px 0;">
					Product Summary
				</summary>
				<div style="margin-top: 12px;">
					<!-- CARE -->
					<details open style="margin-bottom: 10px;">
						<summary style="cursor:pointer; font-weight:600; font-size:1rem; padding:6px 0;">
							CARE
						</summary>
						<div class="metrics" id="productSummaryCARE" style="margin-top:8px;"></div>
						<details style="margin-top:6px; margin-left:16px;">
							<summary style="cursor:pointer; color:#555;">Subcategories</summary>
							<div class="metrics" id="productSummaryCARE_sub" style="margin-top:8px;"></div>
						</details>
					</details>
					<!-- START -->
					<details open style="margin-bottom: 10px;">
						<summary style="cursor:pointer; font-weight:600; font-size:1rem; padding:6px 0;">
							START
						</summary>
						<div class="metrics" id="productSummarySTART" style="margin-top:8px;"></div>
						<details style="margin-top:6px; margin-left:16px;">
							<summary style="cursor:pointer; color:#555;">Subcategories</summary>
							<div class="metrics" id="productSummarySTART_sub" style="margin-top:8px;"></div>
						</details>
					</details>
					<!-- EXACT -->
					<details open style="margin-bottom: 10px;">
						<summary style="cursor:pointer; font-weight:600; font-size:1rem; padding:6px 0;">
							EXACT
						</summary>
						<div class="metrics" id="productSummaryEXACT" style="margin-top:8px;"></div>
						<details style="margin-top:6px; margin-left:16px;">
							<summary style="cursor:pointer; color:#555;">Subcategories</summary>
							<div class="metrics" id="productSummaryEXACT_sub" style="margin-top:8px;"></div>
						</details>
					</details>
				</div>
			</details>
            <h2>Customer Summary</h2>
            
            <div class="metrics">
                <div class="metric-card white">
                    <div class="label">Customers {{ nombre_p1 }}</div>
                    <div class="value" id="custP1">0</div>
                </div>
                <div class="metric-card white">
                    <div class="label">Customers {{ nombre_p2 }}</div>
                    <div class="value" id="custP2">0</div>
                </div>
                <div class="metric-card white">
                    <div class="label">Retained</div>
                    <div class="value" id="custRetained">0</div>
                </div>
                <div class="metric-card white">
                    <div class="label">Lost</div>
                    <div class="value" id="custLost">0</div>
                </div>
                <div class="metric-card white">
                    <div class="label">New</div>
                    <div class="value" id="custNew">0</div>
                </div>
            </div>
            
            <h2>Record Analysis</h2>
            
            <div class="metrics">
                <div class="metric-card white">
                    <div class="label">✅ Common Records</div>
                    <div class="value" id="metricCommon">{{ "{:,}".format(metrics.registros_comunes) }}</div>
                </div>
                <div class="metric-card white">
                    <div class="label">🔴 Only in {{ nombre_p1 }}</div>
                    <div class="value" id="metricOnlyP1">{{ "{:,}".format(metrics.registros_solo_p1) }}</div>
                </div>
                <div class="metric-card white">
                    <div class="label">🟢 Only in {{ nombre_p2 }}</div>
                    <div class="value" id="metricOnlyP2">{{ "{:,}".format(metrics.registros_solo_p2) }}</div>
                </div>
            </div>
            
            <h2>Retention and Acquisition KPIs</h2>
            
            <div class="metrics">
                <div class="metric-card white">
                    <div class="label">Retention Rate</div>
                    <div class="value">{{ "%.1f"|format(metrics.tasa_retencion) }}%</div>
                </div>
                <div class="metric-card white">
                    <div class="label">Acquisition Rate</div>
                    <div class="value">{{ "%.1f"|format(metrics.tasa_captacion) }}%</div>
                </div>
            </div>
            
            <h2>Retained customers: Expansion / Contraction</h2>
            
            <div class="metrics">
                <div class="metric-card white">
                    <div class="label">Expansion €</div>
                    <div class="value" id="expansionEur">€0</div>
                </div>
                <div class="metric-card white">
                    <div class="label">Contraction €</div>
                    <div class="value" id="contractionEur">€0</div>
                </div>
                <div class="metric-card white">
                    <div class="label">Net change €</div>
                    <div class="value" id="netEur">€0</div>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <h3>🔴 Lost customers (Top 20)</h3>
                    <div class="table-container" style="max-height:420px;">
                        <table id="lostCustomersTable">
                            <thead>
                                <tr>
                                    <th onclick="sortTable('lostCustomers', 0)">Customer</th>
                                    <th onclick="sortTable('lostCustomers', 1)">{{ nombre_p1 }} €</th>
                                </tr>
                            </thead>
                            <tbody id="lostCustomersBody"></tbody>
                        </table>
                    </div>
                </div>

                <div class="col-md-6">
                    <h3>🟢 New customers (Top 20)</h3>
                    <div class="table-container" style="max-height:420px;">
                        <table id="newCustomersTable">
                            <thead>
                                <tr>
                                    <th onclick="sortTable('newCustomers', 0)">Customer</th>
                                    <th onclick="sortTable('newCustomers', 1)">{{ nombre_p2 }} €</th>
                                </tr>
                            </thead>
                            <tbody id="newCustomersBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- CHARTS SECTION CON TABS -->
        <div class="info-box" id="charts-section">
            <h2>Comparative Analysis</h2>
            
            <ul class="nav nav-tabs" id="chartsTab" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" data-toggle="tab" href="#reps-chart" role="tab">Sales Representatives</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-toggle="tab" href="#types-chart" role="tab">Product Types</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-toggle="tab" href="#sets-chart" role="tab">Sets</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-toggle="tab" href="#time-chart" role="tab">Time Evolution</a>
                </li>
            </ul>
            
            <div class="tab-content" id="chartsTabContent">
                <div class="tab-pane fade show active" id="reps-chart" role="tabpanel">
                    <div class="chart-container">
                        <div id="chartReps"></div>
                    </div>
                </div>
                
                <div class="tab-pane fade" id="types-chart" role="tabpanel">
                    <div class="chart-container">
                        <div id="chartTypes"></div>
                    </div>
                </div>
                
                <div class="tab-pane fade" id="sets-chart" role="tabpanel">
                    <div class="chart-container">
                        <div id="chartSets"></div>
                    </div>
                </div>
                
                <div class="tab-pane fade" id="time-chart" role="tabpanel">
                    <div class="chart-container">
                        <div id="chartTime"></div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- DATA TABLES SECTION CON TABS -->
        <div class="info-box" id="tables-section">
            <h2>Data Tables</h2>
            
            <ul class="nav nav-tabs" id="dataTablesTab" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" data-toggle="tab" href="#comparison-section" role="tab">📊 Full Comparison</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-toggle="tab" href="#by-customer-section" role="tab">👥 By Customer</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-toggle="tab" href="#only-p1-section" role="tab">🔴 Only {{ nombre_p1 }}</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-toggle="tab" href="#only-p2-section" role="tab">🟢 Only {{ nombre_p2 }}</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-toggle="tab" href="#common-section" role="tab">✅ Common Records</a>
                </li>
            </ul>
            
            <div class="tab-content" id="dataTablesContent">
                <div class="tab-pane fade show active" id="comparison-section" role="tabpanel">
                    <div class="text-right mb-2">
                    <button class="btn btn-sm btn-outline-primary"
                            onclick="downloadTableCSV('comparisonTable','comparison.csv')">
                        ⬇ Download CSV
                    </button>
                    </div>
                    <div class="table-container">
                        <table id="comparisonTable">
                            <thead>
                                <tr>
                                    <th onclick="sortTable('comparison', 0)">Customer</th>
                                    <th onclick="sortTable('comparison', 1)">Product</th>
                                    <th onclick="sortTable('comparison', 2)">Sales Rep</th>
                                    <th onclick="sortTable('comparison', 3)">Amount {{ nombre_p1 }}</th>
                                    <th onclick="sortTable('comparison', 4)">Amount {{ nombre_p2 }}</th>
                                    <th onclick="sortTable('comparison', 5)">Difference</th>
                                    <th onclick="sortTable('comparison', 6)">Growth %</th>
                                </tr>
                            </thead>
                            <tbody id="comparisonBody"></tbody>
                        </table>
                    </div>
                </div>
                <div class="tab-pane fade" id="by-customer-section" role="tabpanel">
                    <div class="text-right mb-2">
                        <button class="btn btn-sm btn-outline-primary"
                                onclick="downloadTableCSV('byCustomerTable','by_customer.csv')">
                        ⬇ Download CSV
                        </button>
                    </div>

                    <div class="table-container">
                        <table id="byCustomerTable">
                        <thead>
                            <tr>
                            <th onclick="sortTable('byCustomer', 0)">Customer</th>
                            <th onclick="sortTable('byCustomer', 1)">{{ nombre_p1 }}</th>
                            <th onclick="sortTable('byCustomer', 2)">{{ nombre_p2 }}</th>
                            <th onclick="sortTable('byCustomer', 3)">Diff (P2-P1)</th>
                            <th onclick="sortTable('byCustomer', 4)">Growth %</th>
                            </tr>
                        </thead>
                        <tbody id="byCustomerBody"></tbody>
                        </table>
                    </div>
                    </div>
                <div class="tab-pane fade" id="only-p1-section" role="tabpanel">    
                    <div class="text-right mb-2">
                    <button class="btn btn-sm btn-outline-primary"
                            onclick="downloadTableCSV('onlyP1Table','only_p1.csv')">
                        ⬇ Download CSV
                    </button>
                    </div>
                   
                    <div class="table-container">
                        <table id="onlyP1Table">
                            <thead>
                                <tr>
                                    <th onclick="sortTable('onlyP1', 0)">Date</th>
                                    <th onclick="sortTable('onlyP1', 1)">Customer</th>
                                    <th onclick="sortTable('onlyP1', 2)">Product</th>
                                    <th onclick="sortTable('onlyP1', 3)">Type</th>
                                    <th onclick="sortTable('onlyP1', 4)">Set</th>
                                    <th onclick="sortTable('onlyP1', 5)">EUR</th>
                                    <th onclick="sortTable('onlyP1', 6)">Sales Rep</th>
                                </tr>
                            </thead>
                            <tbody id="onlyP1Body"></tbody>
                        </table>
                    </div>
                </div>
                
                <div class="tab-pane fade" id="only-p2-section" role="tabpanel">
                    <div class="text-right mb-2">
                    <button class="btn btn-sm btn-outline-primary"
                            onclick="downloadTableCSV('onlyP2Table','only_p2.csv')">
                        ⬇ Download CSV
                    </button>
                    </div>

                    <div class="table-container">
                        <table id="onlyP2Table">
                            <thead>
                                <tr>
                                    <th onclick="sortTable('onlyP2', 0)">Date</th>
                                    <th onclick="sortTable('onlyP2', 1)">Customer</th>
                                    <th onclick="sortTable('onlyP2', 2)">Product</th>
                                    <th onclick="sortTable('onlyP2', 3)">Type</th>
                                    <th onclick="sortTable('onlyP2', 4)">Set</th>
                                    <th onclick="sortTable('onlyP2', 5)">EUR</th>
                                    <th onclick="sortTable('onlyP2', 6)">Sales Rep</th>
                                </tr>
                            </thead>
                            <tbody id="onlyP2Body"></tbody>
                        </table>
                    </div>
                </div>
                
                <div class="tab-pane fade" id="common-section" role="tabpanel">
                    <div class="text-right mb-2">
                    <button class="btn btn-sm btn-outline-primary"
                            onclick="downloadTableCSV('commonTable','common.csv')">
                        ⬇ Download CSV
                    </button>
                    </div>

                    <div class="table-container">
                        <table id="commonTable">
                            <thead>
                                <tr>
                                    <th onclick="sortTable('common', 0)">Period</th>
                                    <th onclick="sortTable('common', 1)">Date</th>
                                    <th onclick="sortTable('common', 2)">Customer</th>
                                    <th onclick="sortTable('common', 3)">Product</th>
                                    <th onclick="sortTable('common', 4)">Type</th>
                                    <th onclick="sortTable('common', 5)">Set</th>
                                    <th onclick="sortTable('common', 6)">EUR</th>
                                    <th onclick="sortTable('common', 7)">Sales Rep</th>
                                </tr>
                            </thead>
                            <tbody id="commonBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- FOOTER -->
        <div style="margin-top: 50px; padding-top: 20px; border-top: 2px solid #eee; text-align: center; color: #666; font-size: 12px;">
            <p>Report generated automatically by Sales Comparison Tool</p>
            <p>Date: {{ timestamp }}</p>
            <p>© {{ year }} BÜCHI Labortechnik AG</p>
        </div>
    </div>
    
    {% include 'partials/_scripts.html' %}
</body>
</html>